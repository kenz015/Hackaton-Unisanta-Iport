# Copie este arquivo para .env dentro da pasta backend e preencha com os valores reais.
# O arquivo .env NÃO deve ser enviado para o Git.

# Azure DevOps (obrigatório para conectar ao Azure DevOps)
ADO_ORG=gs255041
ADO_PROJECT=iCrew
ADO_TEAM=iCrew Team
ADO_PAT=cole-seu-token-aqui

# IA (opcional; sem ela, o backend usa um texto de fallback)
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1

# Flask
FLASK_DEBUG=false
PORT=5000
