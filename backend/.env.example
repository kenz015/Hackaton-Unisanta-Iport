# Azure DevOps (obrigatório para conectar ao Azure DevOps)
ADO_ORG=gs255041
ADO_PROJECT=iCrew
ADO_TEAM=iCrew Team
ADO_PAT=cole-seu-PAT-aqui

# IA (opcional; sem ela, o backend usa um texto de fallback)
AI_API_KEY=cole-sua-chave-aqui
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1

# Créu (chatbot, app.py): chave do Gemini — https://aistudio.google.com/apikey
# Se ficar vazia, o Créu usa a AI_API_KEY acima.
GEMINI_API_KEY=cole-sua-chave-aqui

# Flask
FLASK_DEBUG=false
PORT=5000