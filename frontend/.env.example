# Copie este arquivo para ".env" dentro da pasta frontend e preencha.
# O .env NUNCA vai para o Git.

# ---- Login (Supabase) ----
# Opcional: o login já vem apontando para o Supabase do iCrew.
# Só preencha para usar outro projeto Supabase.
# VITE_SUPABASE_URL=https://xxxx.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=cole-a-chave-publica-aqui

# ---- Azure DevOps (lido só no servidor) ----
# Se preferir, pode deixar estas no .env do backend.
ADO_ORG=gs255041
ADO_PROJECT=iCrew
ADO_TEAM=iCrew Team
ADO_PAT=cole-seu-PAT-aqui

# ---- Backend Python local ----
BACKEND_URL=http://127.0.0.1:5000
VITE_BACKEND_URL=http://127.0.0.1:5000

# ---- IA (opcional) ----
AI_API_KEY=cole-sua-chave-aqui
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1
